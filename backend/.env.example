PORT=5000
NODE_ENV=development

# --- База данных ---
# Для Turso (рекомендуется для Vercel / продакшена):
TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Для локального PostgreSQL (если не используется Turso):
DB_USER=postgres
DB_HOST=localhost
DB_NAME=my_way_db
DB_PASSWORD=your_secure_password
DB_PORT=5432

JWT_SECRET=super_secret_key_for_my_way_psychological_tracker_2026
JWT_EXPIRES_IN=30d
SESSION_SECRET=super_session_secret_for_oauth_state_2026

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Продакшен (Vercel) — тот же домен для фронта и API:
# FRONTEND_URL=https://my-way-tracker.vercel.app
# BACKEND_URL=https://my-way-tracker.vercel.app

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth (https://oauth.yandex.ru/client/new)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Apple Sign In (https://developer.apple.com/account/resources/identifiers/list/serviceId)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=C:\path\to\AuthKey.p8
# или одной строкой с \n:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# VK ID (https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
